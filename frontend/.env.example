# =============================================================================
# Frontend (Next.js) - variáveis de ambiente
# Copie este arquivo para ".env" (dev local) e preencha com valores reais.
# Em produção (Vercel), configure estas mesmas chaves em Project Settings > Environment Variables.
# =============================================================================

# ---- URL do backend Django (django-ninja) --------------------------------
# Usada apenas no proxy server-side (app/api/[[...proxy]]/route.ts) que
# repassa chamadas de /api/* para o backend. NÃO é usada pelo client do
# better-auth (lib/auth-client.ts) — este usa same-origin (window.location.origin)
# e bate em /api/auth/*, servido pelo próprio Next.js em
# app/api/auth/[...all]/route.ts.
# Local: http://localhost:8000
# Produção: URL pública do serviço no Render, ex. https://seu-backend.onrender.com
SERVER_URL=http://localhost:8000

# ---- Better Auth -----------------------------------------------------------
# Segredo usado para assinar sessões/tokens do better-auth. Gere um valor
# aleatório forte (ex.: `openssl rand -base64 32`) e nunca reutilize entre ambientes.
BETTER_AUTH_SECRET=

# URL pública onde o PRÓPRIO frontend está hospedado (usada pelo better-auth
# para gerar links de callback/redirecionamento). Local: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# URL pública do frontend, usada em `trustedOrigins` do better-auth.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ---- Login social (Google OAuth) -------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Envio de e-mails (Resend) ---------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Banco de dados usado pelo better-auth ---------------------------------
# O better-auth conecta diretamente no MESMO Postgres usado pelo backend
# Django (tabelas users/sessions/accounts/verifications compartilhadas).
# Em produção, use as credenciais do Postgres provisionado no Render.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# ---- Armazenamento de arquivos (MinIO/S3) ----------------------------------
# URL pública usada para montar os links de anexos/fotos de perfil no client.
# Local: http://localhost:9000/<bucket>  |  Produção: URL pública do seu S3/MinIO.
NEXT_PUBLIC_MINIO_URL=http://localhost:9000/financas-bucket
