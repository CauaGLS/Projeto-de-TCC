# =============================================================================
# Backend (Django + django-ninja) - variáveis de ambiente
# Copie este arquivo para ".env" (dev local) e preencha com valores reais.
# Em produção (Render), configure estas mesmas chaves em Environment do serviço.
# =============================================================================

# ---- Django core -------------------------------------------------------
# Chave secreta do Django. Obrigatória quando DJANGO_DEBUG=False.
# Gere uma nova com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# "True" em dev local. Em produção (Render) defina "False".
DJANGO_DEBUG=True

# Hosts permitidos, separados por vírgula. Local: "*" ou "localhost,127.0.0.1"
# Produção: domínio do serviço no Render, ex. "seu-backend.onrender.com"
ALLOWED_HOSTS=*

# ---- CORS / CSRF (comunicação com o frontend no Vercel) -----------------
# Origem(ns) do frontend autorizadas a chamar a API, separadas por vírgula.
# Deixe em branco em dev local (com DJANGO_DEBUG=True libera tudo automaticamente).
# Produção, ex.: https://seu-app.vercel.app
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ---- Banco de dados -------------------------------------------------------
# Em produção (Render), defina DATABASE_URL (fornecida automaticamente pelo
# Render Postgres) — ela tem prioridade sobre as variáveis POSTGRES_* abaixo.
# postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=

# Usadas em dev local (docker-compose) quando DATABASE_URL não está definida.
# Este é o MESMO banco usado pelo better-auth no frontend.
POSTGRES_DB=controle_de_financas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Armazenamento de arquivos (MinIO local / S3 em produção) -------------
AWS_STORAGE_BUCKET_NAME=financas-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local: http://localhost:9000 (MinIO). Produção: endpoint do seu provedor S3.
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_SIGNATURE_VERSION=s3v4
